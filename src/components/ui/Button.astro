---
interface Props {
  href?: string;
  dialog?: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
  label?: string;
}
const { href, dialog, variant = 'primary', class: className, label } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---
{href ? <a {href} class:list={classes} aria-label={label}><slot /></a>
  : <button type="button" class:list={classes} data-dialog={dialog} aria-label={label}><slot /></button>}
<style>
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-block-size: 48px; padding: .875rem 1.25rem; border: 0; border-radius: var(--radius-control); font-size: 1.0625rem; font-weight: 700; line-height: 1.2; text-decoration: none; text-align: center; }
  .button--primary { color: var(--color-ink); background: var(--color-accent); }
  .button--primary:hover { background: var(--color-accent-hover); }
  .button--secondary { color: var(--color-bg); background: var(--color-ink); }
  .button--secondary:hover { background: var(--color-muted); }
  .button--text { color: inherit; background: transparent; padding-inline: 0; }
  .button--text:hover { text-decoration: underline; }
  @media (max-width: 600px) { .button { font-size: .9375rem; } }
</style>
