---
interface Benefit {
  title: string;
  description: string;
}

interface Props {
  payment: Benefit;
  warranty: Benefit;
}

const { payment, warranty } = Astro.props;
const benefits = [
  { title: 'Entrega', description: 'Consulte o prazo e o frete para o seu CEP.', icon: 'truck' },
  { ...payment, icon: 'card' },
  { ...warranty, icon: 'shield' },
  { title: 'Atendimento MOV', description: 'Confirme a disponibilidade e os dados do pedido com a equipe.', icon: 'chat' },
];
---

<section class="purchase-benefits" aria-labelledby="purchase-benefits-title">
  <div class="container benefits-inner">
    <h2 id="purchase-benefits-title">Informações de compra</h2>
    <ul class="benefits-list" role="list">
      {benefits.map(({ title, description, icon }) => (
        <li class="benefit">
          <span class="benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              {icon === 'truck' && <><path d="M1 5h15v12H1zM16 9h4l3 4v4h-7" /><circle cx="5.5" cy="17.5" r="2.5" fill="var(--color-surface)" /><circle cx="18.5" cy="17.5" r="2.5" fill="var(--color-surface)" /></>}
              {icon === 'card' && <><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20M6 15h4" /></>}
              {icon === 'shield' && <path d="M12 2 4 5v6c0 5 3 8 8 11 5-3 8-6 8-11V5l-8-3Zm-4 10 3 3 5-5" />}
              {icon === 'chat' && <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H3l2.2-4.3A8.5 8.5 0 1 1 21 11.5ZM8 11h8m-8 4h5" />}
            </svg>
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .purchase-benefits {
    position: relative;
    z-index: 5;
    padding-block: clamp(48px, 6vw, var(--space-section));
    background: #efefeb;
    color: var(--color-ink);
  }
  .benefits-inner {
    max-inline-size: 1200px;
    container-type: inline-size;
  }
  .benefits-inner h2 {
    margin-block-end: clamp(24px, 4vw, 44px);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -.02em;
    text-align: center;
  }
  .benefits-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: clamp(12px, 1.6vw, 24px);
    margin-block: 0;
    padding: 0;
    list-style: none;
  }
  .benefit {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 8px;
    padding: clamp(20px, 2vw, 30px);
    border: 1px solid var(--color-gray);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-align: center;
  }
  .benefit-icon {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-block-end: 4px;
    border-radius: 50%;
    background: #fff3dc;
    color: var(--color-eyebrow);
  }
  .benefit h3 { font-size: 1.125rem; line-height: 1.3; }
  .benefit p { max-inline-size: 28ch; color: var(--color-muted); font-size: .9375rem; line-height: 1.55; }
  @container (min-width: 420px) {
    .benefits-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container (min-width: 960px) {
    .benefits-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
