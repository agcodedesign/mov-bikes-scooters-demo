---
const benefits = [
  { number: '01', title: 'Mobilidade elétrica', description: 'Uma alternativa para fazer seus deslocamentos de outro jeito.' },
  { number: '02', title: 'Modelos para sua rotina', description: 'Explore bicicletas e scooters para diferentes caminhos.' },
  { number: '03', title: 'Praticidade no dia a dia', description: 'Descubra o modelo que combina com você.' },
];
---

<section class="benefits container" aria-labelledby="benefits-title">
  <h2 id="benefits-title">Por que escolher a MOV?</h2>
  <ol class="benefits-grid">
    {benefits.map((benefit) => (
      <li class="benefit-card">
        <span class="benefit-number" aria-hidden="true">{benefit.number}</span>
        <h3>{benefit.title}</h3>
        <p>{benefit.description}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .benefits { padding-top: 110px; padding-bottom: 70px; }
  .benefits h2 { margin: 0 0 34px; }
  .benefits-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin: 0; padding: 0; list-style: none; }
  .benefit-card { min-height: 240px; padding: 26px 24px; border-radius: var(--radius-card); background: #fff; }
  .benefit-number { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: var(--color-accent); font-size: 0.9375rem; font-weight: 800; }
  .benefit-card h3 { margin: 22px 0 8px; font-size: 1.4375rem; font-weight: 800; line-height: 1.25; }
  .benefit-card p { max-width: 360px; margin: 0; color: var(--color-muted); font-size: 1.0625rem; line-height: 1.4; }
  @media (min-width: 768px) and (max-width: 1100px) {
    .benefits-grid { gap: 18px; }
    .benefit-card { padding: 24px 20px; }
    .benefit-card h3 { font-size: 1.3125rem; }
  }
  @media (max-width: 899px) {
    .benefits { padding-top: 64px; padding-bottom: 48px; }
    .benefits h2 { margin-bottom: 24px; }
    .benefits-grid { grid-template-columns: 1fr; gap: 16px; }
    .benefit-card { min-height: 0; padding: 26px 24px; }
    .benefit-card h3 { margin-top: 20px; font-size: 1.4375rem; }
  }
</style>
