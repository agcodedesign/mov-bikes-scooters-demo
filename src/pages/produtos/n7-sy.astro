---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Dialogs from '../../components/layout/Dialogs.astro';
import Button from '../../components/ui/Button.astro';
import ResponsiveImage from '../../components/ui/ResponsiveImage.astro';
import { productParts, productSpecs, productSource, comparisonSource, lightingSource, partLabels, productPhotos } from '../../data/sy-n7';
import { n7Offer } from '../../data/sy-n7';
import { site } from '../../config/site';
const filmTimes=[0,3.1,6.8,7.8,9.2,9.94];
const photoWidths=[640,960,1280,1920];
---
<BaseLayout title="San Yang N7 | Explore cada detalhe — MOV" description="Conheça a San Yang N7: motor anunciado de 1.000 W, bateria removível e detalhes explorados em uma experiência visual controlada pela rolagem." homeMotion={false}>
  <Header />
  <main id="conteudo" tabindex="-1" class="product-page">
    <div class="product-breadcrumb container"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/catalogo/">Catálogo</a><span aria-hidden="true">/</span><span aria-current="page">SY N7</span></div>
    <section class="product-experience" id="explorar" aria-labelledby="product-title">
      <div class="product-viewer" data-product-viewer data-active-part="overview" data-film-times={filmTimes.join(',')}>
        <p class="viewer-hint">Role para explorar cada detalhe.</p>
        <div class="studio-wordmark" aria-hidden="true">SY N7</div>
        <img class="product-poster" src="/images/products/n7/geral.webp" width="2000" height="1116" alt="Vista lateral da scooter elétrica San Yang N7" fetchpriority="high" />
        <video class="product-film" muted playsinline preload="auto" aria-label="Detalhes da SY N7 controlados pela rolagem"><source src="/movies/n7-scrub.mp4" type="video/mp4" /></video>
        <p class="viewer-loading" role="status">Preparando o filme…</p>
        <p class="sr-only" role="status" data-model-announcer></p>
        <nav class="scene-nav" aria-label="Etapas da experiência">{productParts.map(part => <a href={part.id === 'overview' ? '#explorar' : `#tour-${part.id}`} aria-label={partLabels[part.id]} data-scene-link={part.id}>{part.number}</a>)}</nav>
        <noscript><p class="noscript-note">Explore as fotografias e as informações a seguir.</p></noscript>
      </div>
      <div class="product-copy">
        <article class="product-intro product-step" data-scene-step="overview"><div class="story-card">
          <p class="eyebrow">San Yang · Scooter elétrica</p>
          <h1 id="product-title">SY <span>N7.</span></h1>
          <h2>Um jeito mais leve<br />de seguir pela cidade.</h2>
          <p class="intro-description">Estrutura reforçada, bateria removível e motor de 1.000 W: conheça de perto os detalhes da San Yang N7 e os dados anunciados para o modelo.</p>
          <div class="product-actions"><Button href="#tour-frame">Explorar a SY N7 <span aria-hidden="true">↓</span></Button><Button href={site.whatsapp} dialog={site.whatsapp ? undefined : 'contato'} variant="text">Falar com a MOV <span aria-hidden="true">↗</span></Button></div>
          <dl class="product-highlights"><div><dt>Motor</dt><dd>1.000<span> W</span></dd></div><div><dt>Velocidade*</dt><dd>32<span> km/h</span></dd></div><div><dt>Autonomia*</dt><dd>50<span> km</span></dd></div></dl>
          <p class="configuration-note">*Valores anunciados por revendedores. Autonomia e configuração variam conforme uso e unidade.</p>
        </div></article>
        {productParts.slice(1).map(part => <article class="product-step" id={`tour-${part.id}`} data-scene-step={part.id} aria-labelledby={`part-${part.id}-title`}><div class="story-card">
          <div class="chapter-rule" aria-hidden="true"></div><p class="eyebrow">{part.eyebrow}</p>
          <h2 id={`part-${part.id}-title`}>{part.title}</h2><p class="part-description">{part.description}</p>
          <p class="part-stat">{part.stat}<span>{part.statLabel}</span></p>
          <button type="button" class="part-action" data-part={part.id}>Ir para este close <span aria-hidden="true">↗</span></button>
          <details class="part-detail"><summary>Sobre este componente</summary><p>{part.detail}</p></details>
        </div></article>)}
        <article class="product-step product-outro" data-scene-step="complete"><div class="story-card"><p class="eyebrow">O conjunto completo</p><h2>San Yang N7.<br />Pronta para o seu próximo trajeto.</h2><p class="part-description">Do quadro ao cockpit, reveja o conjunto completo e conheça os dados publicados para a N7.</p></div></article>
      </div>
    <section class="product-photos" id="fotos" aria-labelledby="photos-title">
      <div class="container"><p class="eyebrow">A San Yang N7, em cada detalhe</p><h2 id="photos-title">A forma encontra<br />o detalhe.</h2><p class="section-description">As fotografias aproximam os pontos que definem o modelo: a vista completa, o farol e o cockpit.</p>
        <div class="photo-grid"><figure><ResponsiveImage src={`/images/products/n7/${productPhotos[1].name}`} widths={photoWidths} width={productPhotos[1].width} height={productPhotos[1].height} alt={productPhotos[1].alt} sizes="(max-width: 767px) 90vw, 50vw" /><figcaption>{productPhotos[1].caption}</figcaption></figure><div>{productPhotos.slice(2).map(photo=><figure><ResponsiveImage src={`/images/products/n7/${photo.name}`} widths={photoWidths} width={photo.width} height={photo.height} alt={photo.alt} sizes="(max-width: 767px) 90vw, 45vw" /><figcaption>{photo.caption}</figcaption></figure>)}</div></div>
      </div>
    </section>
    </section>
    <section class="purchase container" id="comprar" aria-labelledby="purchase-title">
      <div>
        <p class="eyebrow">Preço e garantia</p>
        <h2 id="purchase-title">{n7Offer.model}</h2>
        <p>Confirme a disponibilidade e as formas de pagamento com a MOV.</p>
      </div>
      <div class="purchase-options">
        <dl>
          <div><dt>Preço</dt><dd>{n7Offer.price}</dd></div>
          <div><dt>Garantia</dt><dd>6 meses</dd><dd class="payment-detail">Motor, bateria e módulo</dd></div>
        </dl>
        {site.whatsapp ? (
          <Button href={site.whatsapp + '?text=' + encodeURIComponent(n7Offer.message)}>Comprar pelo WhatsApp <span aria-hidden="true">&#8594;</span></Button>
        ) : (
          <p class="payment-detail">WhatsApp de vendas indisponível no momento.</p>
        )}
      </div>
    </section>
    <section class="product-specs container" id="especificacoes" aria-labelledby="specs-title"><div><p class="eyebrow">Conheça o conjunto</p><h2 id="specs-title">Os detalhes<br />também contam.</h2><p>Uma referência da San Yang N7 a partir das especificações anunciadas por revendedores. A MOV pode confirmar a configuração da unidade disponível.</p></div><div><table><caption class="sr-only">Ficha de especificações anunciadas para a San Yang N7</caption><tbody>{productSpecs.map(([label,value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table><p class="specs-source">Fontes: <a href={productSource} target="_blank" rel="noopener noreferrer">R1 Elétricos ↗</a>, <a href={comparisonSource} target="_blank" rel="noopener noreferrer">Marca FCF ↗</a> e <a href={lightingSource} target="_blank" rel="noopener noreferrer">Eletron Motos &amp; Bike ↗</a>. Consultadas em 17/11/2026. Potência, velocidade e autonomia são dados publicados pelos revendedores; confirme a versão, a capacidade da bateria e os acessórios que acompanham a unidade com a MOV.</p></div></section>
    <section class="product-faq container" aria-labelledby="faq-title"><h2 id="faq-title">Antes do próximo caminho.</h2><div>
      <details><summary>Qual é a autonomia anunciada da N7?</summary><p>As listagens consultadas informam até 50 km por carga. O alcance real pode mudar com o peso, o relevo, a velocidade e o modo de uso.</p></details>
      <details><summary>Como é a bateria?</summary><p>As fontes descrevem uma bateria de lítio removível. A tensão e a capacidade em Ah não são consistentes nas páginas consultadas; confirme esses dados para a unidade disponível.</p></details>
      <details><summary>Como explorar os detalhes e as fotografias?</summary><p>Role para acompanhar o vídeo pelos pontos do produto ou selecione um número na navegação. Toque em uma fotografia para ampliá-la.</p></details>
      <details><summary>O que confirmar antes da compra?</summary><p>Consulte a MOV sobre a versão, a bateria, os acessórios incluídos, a garantia e as condições de compra da unidade.</p></details>
    </div></section>
    <section class="product-final" aria-labelledby="product-final-title"><picture class="product-final-media" aria-hidden="true"><source media="(max-width: 600px)" srcset="/images/hero/mov-scooter-cidade-mobile-v1-768.webp" /><img src="/images/hero/mov-scooter-cidade-ultrawide-v1-1920.webp" srcset="/images/hero/mov-scooter-cidade-ultrawide-v1-1280.webp 1280w, /images/hero/mov-scooter-cidade-ultrawide-v1-1920.webp 1920w, /images/hero/mov-scooter-cidade-ultrawide-v1-2089.webp 2089w" sizes="100vw" width="2089" height="753" alt="" loading="lazy" decoding="async" /></picture><div class="container"><p class="eyebrow">Seu próximo caminho</p><h2 id="product-final-title">Conhecer é o começo.<br />O próximo passo é seu.</h2><p>Converse com a MOV sobre a San Yang N7, confira a configuração disponível e descubra se ela combina com os seus trajetos.</p><Button href={site.whatsapp} dialog={site.whatsapp ? undefined : 'contato'}>Quero conhecer a N7 <span aria-hidden="true">↗</span></Button><a class="back-link" href="/catalogo/">Voltar ao catálogo →</a></div></section>
  </main>
  <dialog class="photo-lightbox" aria-label="Fotografia ampliada"><button type="button" aria-label="Fechar fotografia">Fechar ×</button><img alt="" /></dialog><Footer /><Dialogs />
</BaseLayout>
<script>import '../../scripts/product-film';</script>
<style>
  .product-page { background: #101715; color: #f7f7f4; }
  .product-breadcrumb { display: flex; flex-wrap: wrap; gap: 12px; padding-block: 24px 8px; font-size: .8125rem; color: #bdc8c1; }
  .product-breadcrumb a { text-decoration: none; padding-block: 6px; }
  .product-breadcrumb span { padding-block: 6px; }
  .product-experience { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(32px,5vw,88px); width: min(1600px, calc(100% - 80px)); margin-inline: auto; padding-block: 24px 80px; align-items: start; }
  .product-viewer { position: sticky; top: 24px; height: calc(100svh - 48px); max-height: 1040px; min-height: 560px; overflow: hidden; border-radius: 28px; border: 1px solid #ffffff14; background: radial-gradient(ellipse at 45% 38%, #34433d 0%, #1b2822 40%, #121b16 75%); }
  .product-canvas, .product-poster { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .product-poster { object-fit: contain; }
  .product-canvas { opacity: 0; }
  .product-viewer.is-ready .product-canvas { opacity: 1; }
  .product-viewer.is-ready .product-poster { opacity: 0; pointer-events: none; }
  .viewer-toolbar { position: absolute; z-index: 3; inset: 18px 18px auto; display: flex; gap: 4px; width: fit-content; border-radius: 99px; padding: 4px; background: #101715de; border: 1px solid #ffffff20; }
  .viewer-toolbar button, .viewer-controls button { background: transparent; color: #e7e7e7; border: 0; border-radius: 99px; min-height: 44px; padding: 10px 14px; font-size: .75rem; font-weight: 600; }
  .viewer-toolbar button[aria-pressed="true"] { background: #e7e7e7; color: #17221d; }
  .viewer-toolbar button:disabled, .viewer-controls button:disabled { opacity: .45; cursor: default; }
  .viewer-hint { position: absolute; z-index: 1; top: 84px; left: 24px; color: #aebbb3; font-size: .8125rem; }
  .viewer-loading { position: absolute; top: 120px; left: 24px; right: 24px; font-size: .875rem; color: #e7e7e7; }
  .noscript-note { position: absolute; bottom: 24px; left: 24px; right: 24px; color: #e7e7e7; font-size: .875rem; }
  .product-viewer.is-ready .viewer-loading { display: none; }
  .viewer-hotspots { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .part-hotspot { position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 6px; pointer-events: auto; border: 0; color: #17221d; background: transparent; padding: 8px; min-width: 44px; min-height: 44px; border-radius: 99px; }
  .part-hotspot > span:first-child { display: grid; place-items: center; width: 27px; height: 27px; background: #ffa300; border-radius: 50%; box-shadow: 0 0 0 5px #ffa30024; font-size: 1.25rem; line-height: 1; }
  .hotspot-name { opacity: 0; padding: 7px 10px; border-radius: 99px; background: #f7f7f4; white-space: nowrap; font-size: .6875rem; font-weight: 700; }
  .part-hotspot:hover .hotspot-name, .part-hotspot:focus-visible .hotspot-name { opacity: 1; }
  .part-hotspot[aria-pressed="true"] > span:first-child { background: #f7f7f4; box-shadow: 0 0 0 5px #ffffff30; }
  .viewer-caption { position: absolute; inset: auto 24px 82px; display: flex; gap: 14px; align-items: start; pointer-events: none; background: linear-gradient(0deg,#121b16ed,#121b1680); padding: 14px 12px; border-radius: 12px; }
  .viewer-part-number { color: #ffa300; font-size: .6875rem; line-height: 2; }
  .viewer-part-title { font-size: 1rem; font-weight: 700; margin-bottom: 5px; }
  .viewer-caption p:last-child { font-size: .75rem; line-height: 1.5; color: #b6c2ba; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .viewer-controls { position: absolute; inset: auto 18px 18px; display: flex; justify-content: space-between; z-index: 3; }
  .viewer-controls > div { display: flex; gap: 6px; }
  .viewer-controls button { background: #101715d9; border: 1px solid #ffffff20; }
  .viewer-controls [data-zoom] { min-width: 44px; font-size: 1.25rem; }
  .product-copy { min-width: 0; }
  .product-step { min-height: 88svh; display: flex; flex-direction: column; justify-content: center; padding-block: 64px; scroll-margin-top: 24px; }
  .product-intro { min-height: calc(100svh - 110px); padding-block: 32px 64px; }
  .eyebrow { color: #ffa300; font-size: .75rem; letter-spacing: .06em; }
  h1 { font-size: clamp(4.25rem,7vw,7rem); line-height: .98; font-weight: 800; letter-spacing: -.06em; margin-block: 24px 30px; }
  h1 span { display: block; }
  .product-intro h2 { font-size: clamp(1.75rem,2.7vw,2.75rem); }
  .intro-description, .part-description { color: #c3cec6; font-size: 1.0625rem; line-height: 1.7; margin-block-start: 20px; }
  .product-actions { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 26px; }
  .product-actions :global(.button) { font-size: .875rem; }
  .product-highlights { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; padding: 28px 0 0; margin: 28px 0 0; border-top: 1px solid #ffffff24; }
  dt { font-size: .6875rem; color: #aebbb3; margin-bottom: 8px; }
  dd { margin: 0; font-size: clamp(1rem,1.7vw,1.5rem); font-weight: 700; white-space: nowrap; }
  dd span { font-size: .75rem; font-weight: 400; }
  .configuration-note, .model-note { font-size: .75rem; color: #afbbb3; line-height: 1.7; margin-top: 20px; }
  .chapter-rule { width: 56px; height: 3px; background: #ffa300; margin-bottom: 24px; }
  .product-step:not(.product-intro) h2 { font-size: clamp(2.25rem,3.6vw,3.75rem); line-height: 1.12; margin-top: 18px; }
  .part-stat { margin-top: 28px; color: #f7f7f4; font-size: clamp(1.875rem,3vw,2.75rem); line-height: 1.2; font-weight: 700; }
  .part-stat span { display: block; font-size: .8125rem; line-height: 1.5; color: #afbbb3; font-weight: 400; margin-top: 8px; }
  .part-action { align-self: flex-start; margin-top: 24px; border: 1px solid #6a786f; padding: 12px 18px; border-radius: 99px; background: transparent; color: #f7f7f4; font-size: .875rem; min-height: 44px; }
  .part-action span { margin-left: 15px; color: #ffa300; }
  .part-detail { font-size: .8125rem; line-height: 1.7; margin-top: 28px; color: #afbbb3; }
  .model-note { padding-block: 24px; border-top: 1px solid #ffffff24; }
  .product-photos { position:relative; z-index:4; margin-block-start:-42svh; border-radius:32px 32px 0 0; background: var(--color-bg); color: var(--color-ink); padding-block: 100px; box-shadow:0 -30px 90px #0005; }
  .product-photos .eyebrow, .product-specs .eyebrow { color: #955900; }
  .product-photos h2 { font-size: clamp(2.75rem,5vw,5rem); margin-top: 18px; }
  .section-description { margin-top: 24px; max-width: 590px; color: var(--color-muted); }
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px; align-items: start; }
  .photo-grid > div { display: grid; gap: 28px; }
  .photo-grid :global(img) { width: 100%; border-radius: 24px; }
  figcaption { color: #56645c; font-size: .8125rem; margin-top: 12px; }
  .product-specs { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; padding-block: 100px; }
  .product-specs .eyebrow { color: #ffa300; }
  .product-specs h2 { font-size: clamp(2.5rem,4vw,4rem); margin-top: 20px; }
  .product-specs > div > p:not(.eyebrow) { color: #afbbb3; line-height: 1.7; margin-top: 24px; }
  table { width: 100%; border-collapse: collapse; font-size: .9375rem; }
  th, td { text-align: start; padding: 17px 0; border-bottom: 1px solid #ffffff24; vertical-align: top; }
  th { font-weight: 400; color: #afbbb3; width: 45%; padding-right: 16px; }
  td { font-weight: 600; }
  .specs-source { font-size: .75rem; }
  .specs-source a { color: #e7e7e7; }
  .product-faq { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; padding-bottom: 100px; }
  .product-faq h2 { font-size: clamp(2rem,3vw,3rem); max-width: 350px; }
  details { border-bottom: 1px solid #ffffff24; padding-block: 20px; }
  summary { font-size: 1rem; font-weight: 600; cursor: pointer; min-height: 32px; }
  details p { color: #afbbb3; line-height: 1.7; margin-top: 18px; font-size: .9375rem; }
  .product-final { padding-block: 100px; background: #e7e7e7; color: #17221d; }
  .product-final .eyebrow { color: #955900; }
  .product-final h2 { font-size: clamp(2.5rem,4vw,4.5rem); margin-block: 20px; }
  .product-final p:not(.eyebrow) { max-width: 540px; color: #536157; margin-bottom: 28px; }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; font-size: .875rem; margin-left: 24px; }
  @media (prefers-reduced-motion: no-preference) { .product-canvas, .product-poster { transition: opacity 600ms ease; } .part-action, .viewer-controls button { transition: background-color 160ms ease; } .part-action:hover { background: #ffffff12; } }
  @media (max-width: 1099px) {
    .product-experience { width: calc(100% - 48px); grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); gap: 28px; }
    .product-viewer { min-height: 480px; }
    .product-intro h1 { font-size: 4.25rem; }
    .intro-description, .part-description { font-size: .9375rem; }
    .product-specs, .product-faq { gap: 40px; }
    .product-actions { flex-direction: column; align-items: flex-start; }
    .product-highlights { grid-template-columns: 1fr; gap: 14px; }
    .product-highlights > div { display: flex; align-items: baseline; justify-content: space-between; }
  }
  @media (max-width: 767px) {
    .product-photos { margin-block-start:-30svh; }
    .product-breadcrumb { padding-top: 12px; }
    .product-experience { display: block; width: 100%; padding-block: 12px 48px; }
    .product-viewer { top: 0; height: 54svh; min-height: 330px; max-height: 560px; border-radius: 0 0 24px 24px; z-index: 3; border-inline: 0; }
    .viewer-toolbar { inset: 12px 12px auto; }
    .viewer-toolbar button { padding: 8px 12px; font-size: .6875rem; }
    .viewer-hint { top: 72px; left: 20px; font-size: .6875rem; }
    .viewer-caption { inset: auto 16px 64px; padding: 9px 10px; gap: 10px; }
    .viewer-caption p:last-child { font-size: .6875rem; -webkit-line-clamp: 1; }
    .viewer-part-title { font-size: .8125rem; margin-bottom: 3px; }
    .viewer-controls { inset: auto 12px 10px; }
    .viewer-loading { top: 100px; left: 20px; font-size: .75rem; }
    .product-copy { padding-inline: var(--gutter); }
    .product-step { min-height: 78svh; padding-block: 44px; scroll-margin-top: 56svh; }
    .product-intro { min-height: auto; padding-block: 32px 48px; }
    .product-intro h1 { font-size: 4rem; margin-block: 20px; }
    .product-intro h1 span { display: inline; }
    .product-intro h2 { font-size: 1.75rem; }
    .product-highlights { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
    .product-highlights > div { display: block; }
    .product-highlights dd { font-size: 1.125rem; }
    .product-actions { flex-direction: row; align-items: center; }
    .product-step:not(.product-intro) h2 { font-size: 2.25rem; }
    .part-stat { font-size: 1.875rem; }
    .hotspot-name { display: none; }
    .product-photos, .product-specs, .product-final { padding-block: 56px; }
    .product-photos { margin-block-start:-34svh; border-radius:24px 24px 0 0; }
    .photo-grid { grid-template-columns: 1fr; gap: 28px; margin-top: 32px; }
    .photo-grid :global(img) { border-radius: 16px; }
    .product-specs, .product-faq { grid-template-columns: 1fr; gap: 28px; }
    .product-faq { padding-bottom: 56px; }
    th, td { font-size: .8125rem; padding-block: 15px; }
    .back-link { display: flex; width: fit-content; margin: 16px 0 0; }
  }
  /* The product remains in a full-viewport studio; the story passes over it. */
  .product-breadcrumb { position: absolute; z-index: 4; left: var(--gutter); width: auto; padding: 18px 0; }
  .product-experience { display: block; position: relative; width: 100%; padding: 0; }
  .product-viewer { top: 0; z-index: 1; width: 100%; height: 100svh; min-height: 560px; max-height: none; border: 0; border-radius: 0; background: radial-gradient(ellipse at 70% 42%,#35423e 0%,#18211f 43%,#090f0d 85%); }
  .product-viewer::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg,#080e0cd9,transparent 44%),linear-gradient(0deg,#090f0d99,transparent 22%); }
