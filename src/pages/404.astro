---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Dialogs from '../components/layout/Dialogs.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Página não encontrada | MOV" description="Volte ao início ou explore as bicicletas e scooters elétricas da MOV." homeMotion={false}>
  <Header />
  <main id="conteudo" tabindex="-1" class="lost-road">
    <div class="container road-layout">
      <div class="road-content">
        <p class="eyebrow">Erro 404</p>
        <h1>Página não encontrada.</h1>
        <p class="description">O endereço pode ter mudado. Volte ao início ou veja os modelos de bicicletas e scooters elétricas no catálogo.</p>
        <div class="actions">
          <Button href="/">Voltar ao início <span aria-hidden="true">&#8594;</span></Button>
          <a class="catalog-link" href="/catalogo/">Ver catálogo <span aria-hidden="true">&#8594;</span></a>
        </div>
      </div>
      <div class="road-visual" aria-hidden="true">
        <picture>
          <source media="(max-width: 767px)" srcset="/images/hero/mov-ciclista-orla-mobile-v1-768.webp" />
          <img src="/images/hero/mov-ciclista-orla-ultrawide-v1-1280.webp" width="1280" height="461" alt="" />
        </picture>
        <span class="road-number">404</span>
      </div>
    </div>
  </main>
  <Footer />
  <Dialogs />
</BaseLayout>

<style>
  .lost-road {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: clamp(40px, 6vw, 96px);
  }
  .road-layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .eyebrow { color: var(--color-accent); }
  h1 {
    margin-block-start: 16px;
    font-size: clamp(2.25rem, 4vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .description {
    max-inline-size: 43ch;
    margin-block-start: 20px;
    color: #d0d9d2;
    line-height: 1.65;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-block-start: 28px; }
  .catalog-link { display: inline-flex; align-items: center; gap: 10px; min-block-size: 44px; }
  .catalog-link span { color: var(--color-accent); }
  .road-visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-card);
    min-block-size: 380px;
    aspect-ratio: 1.65;
    background: #101715;
  }
  .road-visual picture, .road-visual::after { position: absolute; inset: 0; }
  .road-visual img { width: 100%; height: 100%; object-fit: cover; object-position: 78% center; }
  .road-visual::after { content: ''; background: linear-gradient(to top, #101715de, transparent 62%); }
  .road-number {
    position: absolute;
    z-index: 1;
    inset-inline-start: 5%;
    inset-block-end: 2%;
    color: var(--color-accent);
    font-size: clamp(5rem, 10vw, 12rem);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -.065em;
  }
  @media (max-width: 767px) {
    .road-layout { grid-template-columns: minmax(0, 1fr); }
    .road-visual { aspect-ratio: 1.35; min-block-size: 0; max-block-size: 360px; }
    .road-visual img { object-position: center 55%; }
  }
</style>
