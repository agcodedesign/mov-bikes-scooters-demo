---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Dialogs from '../components/layout/Dialogs.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Caminho não encontrado — MOV" description="Este endereço não foi encontrado. Volte ao início ou descubra as bicicletas e scooters elétricas no catálogo MOV." homeMotion={false}>
  <Header />
  <main id="conteudo" tabindex="-1" class="lost-road">
    <picture class="road-image" aria-hidden="true">
      <source media="(max-width: 600px)" srcset="/images/hero/mov-ciclista-orla-mobile-v1-941.webp" />
      <img src="/images/hero/mov-ciclista-orla-ultrawide-v1-1920.webp" width="2089" height="753" alt="" fetchpriority="high" />
    </picture>
    <div class="container road-content">
      <p class="eyebrow"><span aria-hidden="true"></span> UM NOVO CAMINHO COMEÇA AQUI</p>
      <p class="error-code" aria-label="Erro 404">4<span>0</span>4<span class="route-dot" aria-hidden="true"></span></p>
      <h1>Esse caminho<br />ficou pelo caminho.</h1>
      <p class="description">O endereço pode ter mudado ou não existir mais. Sua próxima descoberta continua a poucos cliques daqui.</p>
      <div class="actions"><Button href="/catalogo/">Explorar catálogo <span aria-hidden="true">↗</span></Button><a class="home-link" href="/">Voltar ao início <span aria-hidden="true">→</span></a></div>
      <div class="road-note"><span aria-hidden="true">↗</span><p>Outra rota.<br /><strong>O mesmo desejo de seguir.</strong></p></div>
    </div>
    <p class="image-caption" aria-hidden="true">MOVIMENTO É ENCONTRAR NOVOS CAMINHOS.</p>
  </main>
  <Footer /><Dialogs />
</BaseLayout>
<style>
  .lost-road { position:relative; isolation:isolate; overflow:hidden; min-height:calc(100svh - 90px); background:#101715; color:#f7f7f4; display:flex; align-items:center; padding-block:72px; }
  .road-image { position:absolute; inset:0; z-index:-2; }
  .road-image img { width:100%; height:100%; object-fit:cover; object-position:70% center; }
  .lost-road::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,#07100bf5 0%,#07100be3 30%,#07100b45 72%),linear-gradient(0deg,#07100b99,transparent 45%); }
  .road-content { width:100%; }
  .eyebrow { display:flex; align-items:center; gap:12px; font-size:.6875rem; font-weight:700; letter-spacing:.1em; color:#ffa300; }
  .eyebrow > span { width:36px; height:2px; background:currentColor; }
  .error-code { position:relative; width:fit-content; font-size:clamp(6rem,11vw,11rem); font-weight:800; line-height:1; letter-spacing:-.075em; margin-block:24px 20px; }
  .error-code > span:first-child { color:transparent; -webkit-text-stroke:1.5px #ffa300; }
  .route-dot { display:inline-block; width:12px; height:12px; margin-left:16px; border-radius:50%; background:#ffa300; box-shadow:0 0 0 8px #ffa30018; }
  h1 { max-width:680px; font-size:clamp(2.5rem,4.2vw,4.5rem); line-height:1.08; letter-spacing:-.045em; text-wrap:balance; }
  .description { max-width:430px; margin-top:24px; color:#d0d9d2; line-height:1.7; font-size:1rem; }
  .actions { display:flex; flex-wrap:wrap; align-items:center; gap:16px 28px; margin-top:32px; }
  .home-link { display:inline-flex; align-items:center; gap:18px; min-height:44px; font-size:.875rem; text-decoration:none; }
  .home-link span { color:#ffa300; transition:transform .2s ease; }
  .home-link:hover span { transform:translateX(4px); }
  .road-note { display:flex; gap:16px; align-items:center; margin-top:48px; padding-top:24px; border-top:1px solid #ffffff26; max-width:430px; }
  .road-note > span { font-size:1.5rem; color:#ffa300; }
  .road-note p { font-size:.75rem; line-height:1.7; color:#b7c4bb; }
  .road-note strong { font-weight:500; color:#eef1ed; }
  .image-caption { position:absolute; right:var(--gutter); bottom:32px; font-size:.625rem; letter-spacing:.13em; color:#f7f7f4b3; }
  @media(prefers-reduced-motion:no-preference) { .road-content { animation:arrive .7s cubic-bezier(.2,.7,.2,1) both; } @keyframes arrive { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } } }
  @media(max-width:767px) { .lost-road { min-height:calc(100svh - 72px); padding-block:64px 40px; } .lost-road::before { background:linear-gradient(90deg,#07100bdb,#07100b80),linear-gradient(0deg,#07100bf5,transparent); } .road-image img { object-position:center; } .eyebrow { font-size:.5625rem; letter-spacing:.07em; } .error-code { margin-top:32px; } .description { max-width:34ch; font-size:.9375rem; } .road-note { margin-top:36px; } .image-caption { display:none; } }
  @media(prefers-reduced-motion:reduce) { .home-link span { transition:none; } }

  .lost-road { --content-width:1600px; --gutter:40px; }
  @media(max-width:1099px) { .lost-road { --gutter:clamp(40px,5vw,96px); } }
  @media(max-width:600px) { .lost-road { --gutter:20px; } }
</style>
