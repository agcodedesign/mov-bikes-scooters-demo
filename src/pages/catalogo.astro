---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { n7Offer } from '../data/sy-n7';
import { v8Offer } from '../data/v8-offer';
import Dialogs from '../components/layout/Dialogs.astro';
const products=[
 {id:'v8',name:'V8 Pro S',type:'Bicicleta elétrica',category:'bicicleta',image:'/images/products/mov-v8-pro-s-frontal-1280.webp',alt:'Farol circular e roda dianteira da bicicleta elétrica V8 Pro S',href:'/produtos/v8-pro-s/',description:'Bicicleta elétrica com pneus 20 × 4,0, duas baterias removíveis e motor de 1.000 W.'},
 {id:'n7',name:'SY N7',type:'Scooter elétrica',category:'scooter',image:'/images/products/n7/geral.webp',alt:'Scooter elétrica SY N7 em vista de três quartos',href:'/produtos/n7-sy/',description:'Scooter elétrica com motor de 1.000 W, bateria removível e painel digital.'}
];
---
<BaseLayout title="Catálogo | MOV Bikes & Scooters" description="Conheça bicicletas e scooters elétricas MOV e encontre o modelo para a sua rotina." homeMotion={false}>
<Header/><main id="conteudo" class="catalog-page"><section class="catalog-hero"><div class="catalog-wrap"><p class="eyebrow">Bikes & scooters elétricas</p><h1>Bicicletas e scooters elétricas.</h1><p class="lead">Conheça a V8 Pro S e a San Yang N7. Veja as fotos e as especificações de cada modelo.</p><a class="scroll-link" href="#modelos">Ver modelos <span aria-hidden="true">↓</span></a><img class="hero-mark" src="/images/brand/mov-logo-simbolo.webp" width="871" height="283" alt="" aria-hidden="true" decoding="async" /></div></section><section class="catalog-list" id="modelos" aria-labelledby="models-title"><div class="catalog-wrap"><div class="section-head"><div><p class="eyebrow">A vitrine MOV</p><h2 id="models-title">Modelos para conhecer.</h2></div><p>Veja as fotos, explore os detalhes e fale com a equipe para confirmar a configuração disponível.</p></div><div class="filters" role="group" aria-label="Filtrar modelos por categoria">{[['todos','Todos'],['bicicleta','Bicicletas'],['scooter','Scooters']].map(([value,label],i)=><button type="button" data-filter={value} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><p class="result-count" role="status" aria-live="polite">2 modelos</p><div class="catalog-grid">{products.map((product,index)=><article class="product-card" data-category={product.category} style={`--card-index:${index}`}><a class="card-image" href={product.href} aria-label={`Conhecer ${product.name}`}><img src={product.image} alt={product.alt} loading={index===0?'eager':'lazy'} /><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><p class="product-type">{product.type}</p><h3>{product.name}</h3><p>{product.description}</p><a class="card-link" href={product.href + '#comprar'}>{product.id === 'v8' ? v8Offer.price + ' | Ver oferta' : n7Offer.price + ' | Ver oferta'} <span aria-hidden="true">→</span></a></div></article>)}</div><p class="empty-state" hidden>Nenhum modelo nesta categoria. <button type="button" data-filter="todos">Ver todos os modelos</button></p></div></section></main><Footer/><Dialogs/>
</BaseLayout>
<script>
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.filters [data-filter]')];const cards=[...document.querySelectorAll<HTMLElement>('.product-card')];const count=document.querySelector<HTMLElement>('.result-count')!;const empty=document.querySelector<HTMLElement>('.empty-state')!;
buttons.forEach(button=>button.addEventListener('click',()=>{const value=button.dataset.filter!;buttons.filter(x=>x.hasAttribute('aria-pressed')).forEach(x=>x.setAttribute('aria-pressed',String(x===button)));let shown=0;cards.forEach(card=>{const visible=value==='todos'||card.dataset.category===value;card.hidden=!visible;if(visible)shown++});count.textContent=`${shown} ${shown===1?'modelo':'modelos'}`;empty.hidden=shown>0;}));
const category=new URLSearchParams(location.search).get('categoria');
if(category==='bicicleta'||category==='scooter')buttons.find(button=>button.dataset.filter===category)?.click();
</script>
<style>
.catalog-page{background:#101715;color:#f7f7f4}.catalog-wrap{width:min(1320px,calc(100% - 48px));margin-inline:auto}.catalog-hero{min-height:min(76svh,760px);display:flex;align-items:center;overflow:hidden;position:relative;background:radial-gradient(ellipse at 78% 55%,#35443d 0%,#17211c 45%,#101715 76%)}.catalog-hero .catalog-wrap{position:relative;padding-block:100px}.eyebrow{color:#ffa300;font-size:.75rem;line-height:1.5;letter-spacing:.06em;text-transform:uppercase;font-weight:700}.catalog-hero h1{font-size:clamp(3.25rem,8vw,7.5rem);line-height:.98;letter-spacing:-.055em;max-width:850px;text-wrap:balance;margin-block:20px}.lead{font-size:clamp(1.0625rem,1.6vw,1.25rem);line-height:1.6;color:#c6d0ca;max-width:55ch}.scroll-link{display:inline-flex;gap:18px;align-items:center;margin-top:28px;padding:13px 20px;background:#ffa300;color:#101715;border-radius:99px;text-decoration:none;font-weight:700;transition:transform .2s,box-shadow .2s}.scroll-link:hover{transform:translateY(-2px);box-shadow:0 8px 24px #ffa30040}.hero-mark{position:absolute;right:0;top:50%;transform:translateY(-50%);font-size:clamp(9rem,33vw,34rem);font-weight:800;letter-spacing:-.1em;color:#ffffff07;pointer-events:none}.catalog-list{padding-block:clamp(64px,9vw,120px)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:40px}.section-head h2{font-size:clamp(2.5rem,5vw,5rem);letter-spacing:-.04em;line-height:1.06;margin-top:12px}.section-head>p{max-width:42ch;color:#b9c4bd;line-height:1.6}.filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:48px}.filters button{min-height:44px;padding:10px 20px;border:1px solid #65716b;border-radius:99px;background:transparent;color:#e7e7e7;font:inherit;cursor:pointer;transition:background .18s,color .18s,border-color .18s}.filters button:hover{border-color:#ffa300}.filters button[aria-pressed=true]{background:#ffa300;border-color:#ffa300;color:#101715;font-weight:700}.result-count{min-height:24px;color:#aebbb3;font-size:.875rem;margin-top:20px}.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin-top:14px}.product-card{min-width:0;border:1px solid #ffffff1c;border-radius:24px;overflow:hidden;background:#18211d;animation:card-in .55s both;animation-delay:calc(var(--card-index)*90ms);transition:transform .25s,border-color .25s,box-shadow .25s}.product-card:hover{transform:translateY(-5px);border-color:#ffa30070;box-shadow:0 24px 60px #0004}.card-image{display:block;position:relative;overflow:hidden;background:#202a25;aspect-ratio:1.65}.card-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.8,.2,1)}.product-card:hover img,.card-image:focus-visible img{transform:scale(1.035)}.image-arrow{position:absolute;right:18px;top:18px;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#101715cc;color:#ffa300;font-size:1.2rem;backdrop-filter:blur(12px)}.card-copy{padding:clamp(22px,3vw,36px)}.product-type{color:#ffa300;text-transform:uppercase;letter-spacing:.06em;font-size:.75rem;font-weight:700}.card-copy h3{font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.15;margin-block:10px}.card-copy>p:not(.product-type){color:#c0cbc3;line-height:1.6;max-width:48ch}.card-link{display:inline-flex;align-items:center;gap:16px;margin-top:22px;padding:10px 0;color:#f7f7f4;text-decoration:none;font-weight:700}.card-link span{color:#ffa300;transition:transform .2s}.card-link:hover span{transform:translateX(5px)}.empty-state{padding-block:30px;color:#c0cbc3}.empty-state button{border:0;background:none;color:#ffa300;font:inherit;text-decoration:underline;cursor:pointer}.product-card[hidden]{display:none}@keyframes card-in{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}:focus-visible{outline:3px solid #ffa300;outline-offset:4px}@media(max-width:700px){.catalog-wrap{width:calc(100% - 40px)}.catalog-hero{min-height:68svh}.catalog-hero .catalog-wrap{padding-block:72px}.catalog-hero h1{font-size:clamp(3rem,14vw,5rem)}.section-head{display:block}.section-head>p{margin-top:18px}.filters{margin-top:32px}.catalog-grid{grid-template-columns:minmax(0,1fr);gap:18px}.card-image{aspect-ratio:1.3}.card-copy{padding:24px}.catalog-list{padding-block:64px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}

.catalog-wrap { width:min(var(--content-width),calc(100% - var(--gutter)*2)); }
.catalog-hero { min-height:0; }
.catalog-hero .catalog-wrap { padding-block:72px; }
.catalog-hero h1 { font-size:clamp(2.25rem,3.5vw,3.5rem); line-height:1.2; letter-spacing:-.02em; max-width:22ch; }
.lead { font-size:1.0625rem; line-height:1.6; max-width:62ch; }
.section-head h2 { font-size:clamp(1.75rem,2.5vw,2.5rem); line-height:1.25; letter-spacing:-.02em; }
.card-copy h3 { font-size:clamp(1.5rem,2vw,2rem); line-height:1.25; letter-spacing:-.015em; }
.result-count { font-variant-numeric:tabular-nums; }
.hero-mark { font-size:clamp(8rem,22vw,22rem); }
@media(max-width:700px) { .catalog-wrap { width:calc(100% - var(--gutter)*2); } .catalog-hero .catalog-wrap { padding-block:48px; } .catalog-hero h1 { font-size:clamp(2rem,7vw,2.75rem); } .section-head { gap:24px; } }

.catalog-page { --content-width:1600px; --gutter:40px; }
.catalog-wrap { inline-size:min(1600px,calc(100% - var(--gutter)*2)); width:min(1600px,calc(100% - var(--gutter)*2)); flex-shrink:0; min-inline-size:0; margin-inline:auto; }
.catalog-hero h1 { font-size:clamp(1.875rem,2.5vw,2.75rem); line-height:1.25; max-inline-size:30ch; }
.section-head h2 { font-size:clamp(1.5rem,2vw,2rem); line-height:1.3; }
.card-copy h3 { font-size:1.5rem; line-height:1.3; }
.lead,.section-head>p,.card-copy>p:not(.product-type) { font-size:1rem; line-height:1.6; }
.card-link,.filters button { font-size:.875rem; }
.catalog-hero .catalog-wrap { padding-block:56px; }
.catalog-list { padding-block:64px; }
.hero-mark { display:none; }
@media(max-width:1099px) { .catalog-page { --gutter:clamp(40px,5vw,96px); } }
@media(max-width:600px) { .catalog-page { --gutter:20px; } .catalog-hero h1 { font-size:2rem; } .catalog-hero .catalog-wrap { padding-block:40px; } }

.catalog-hero { isolation:isolate; }
.catalog-hero .catalog-wrap { padding-block:72px; }
.catalog-hero h1,.catalog-hero .lead,.catalog-hero .eyebrow,.catalog-hero .scroll-link { position:relative; z-index:1; }
.hero-mark { display:block; position:absolute; width:min(48%,720px); height:auto; right:0; top:50%; transform:translateY(-50%); opacity:.055; pointer-events:none; }
.catalog-hero .lead { max-width:52ch; }
.catalog-list { border-top:1px solid #ffffff0d; }
.filters { margin-top:32px; }
.card-copy { display:flex; flex-direction:column; align-items:flex-start; padding:28px; min-height:240px; }
.card-copy h3 { margin-block:8px 14px; font-size:1.625rem; }
.card-copy>p:not(.product-type) { max-width:52ch; }
.card-link { margin-top:auto; padding-top:24px; width:100%; justify-content:space-between; }
.card-image { aspect-ratio:1.85; }
.product-card[data-category="scooter"] .card-image img { object-fit:contain; }
@media(max-width:700px) { .catalog-hero .catalog-wrap { padding-block:44px 56px; } .hero-mark { width:75%; top:auto; bottom:12px; transform:none; right:-8%; opacity:.04; } .card-copy { padding:24px; min-height:230px; } .card-image { aspect-ratio:1.5; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .section-head, .filters, .card-copy {
        animation: reveal-content linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 65%;
      }
    }
  }
  @keyframes reveal-content {
    from { opacity: .35; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
